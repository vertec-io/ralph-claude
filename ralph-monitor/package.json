{
  "name": "ralph-monitor",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,green \"bun run dev:server\" \"bun run dev:ui\"",
    "dev:server": "bun --watch run server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "bun run server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bun-pty": "^0.4.8",
    "chokidar": "^4.0.3",
    "hono": "^4.7.0",
    "lucide-react": "^1.14.0",
    "marked": "^15.0.0",
    "xterm": "^5.0.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
